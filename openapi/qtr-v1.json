  "components": {
    "schemas": {
      "CreateVmRequest": {
        "type": "object",
        "required": [
          "name",
          "disks",
          "memoryGiB",
          "vcpus",
          "network",
          "graphics",
          "vncListen"
        ],
        "properties": {
          "boot": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "cdrom": {
            "type": [
              "string",
              "null"
            ]
          },
          "disks": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "graphics": {
            "$ref": "#/components/schemas/GraphicsMode"
          },
          "ioThreads": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/VmIoThreads"
              }
            ]
          },
          "memoryGiB": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "network": {
            "type": "string"
          },
          "serialLog": {
            "type": [
              "string",
              "null"
            ]
          },
          "vcpus": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "vncListen": {
            "type": "string"
          },
          "vncPort": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "DiskFormat": {
        "type": "string",
        "enum": [
          "raw",
          "qcow2"
        ]
      },
      "FedoraInstallMirror": {
        "type": "string",
        "enum": [
          "official",
          "tuna"
        ]
      },
      "FedoraInstallRequest": {
        "type": "object",
        "required": [
          "name",
          "mediaId",
          "imageId",
          "sshAuthorizedKey"
        ],
        "properties": {
          "diskSize": {
            "type": "string"
          },
          "hostname": {
            "type": [
              "string",
              "null"
            ]
          },
          "imageId": {
            "type": "string"
          },
          "keepFailed": {
            "type": "boolean"
          },
          "mediaId": {
            "type": "string"
          },
          "memoryMib": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "mirror": {
            "$ref": "#/components/schemas/FedoraInstallMirror"
          },
          "name": {
            "type": "string"
          },
          "network": {
            "type": "string"
          },
          "sshAuthorizedKey": {
            "type": "string"
          },
          "timeoutSecs": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "vcpus": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "verifyTimeoutSecs": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "GraphicsMode": {
        "type": "string",
        "enum": [
          "none",
          "vnc"
        ]
      },
      "HealthStatus": {
        "type": "object",
        "required": [
          "ok",
          "libvirtUri",
          "version"
        ],
        "properties": {
          "libvirtUri": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "InstallJob": {
        "type": "object",
        "required": [
          "id",
          "status",
          "phase",
          "cancelRequested",
          "request",
          "createdAtMs"
        ],
        "properties": {
          "cancelRequested": {
            "type": "boolean"
          },
          "createdAtMs": {
            "type": "integer",
            "format": "int64"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "finishedAtMs": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "id": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "request": {
            "$ref": "#/components/schemas/FedoraInstallRequest"
          },
          "startedAtMs": {
